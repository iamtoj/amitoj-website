---
import {
  isNavigationItemActive,
  navigationItemsFor,
  type NavigationPlacement,
} from '../data/navigation';

interface Props {
  placement: 'desktop' | 'mobile' | 'footer';
  currentPath: string;
  id?: string;
  hidden?: boolean;
}

const { placement, currentPath, id, hidden = false } = Astro.props;
const navigationPlacement: NavigationPlacement = placement === 'footer' ? 'footer' : 'primary';
const items = navigationItemsFor(navigationPlacement);
const label = placement === 'desktop'
  ? 'Primary navigation'
  : placement === 'mobile'
    ? 'Mobile navigation'
    : 'Footer navigation';
---

<nav
  id={id}
  aria-label={label}
  hidden={hidden}
  class:list={[
    { 'hidden md:block': placement === 'desktop' },
    { 'md:hidden mt-6 border-t border-oat-300 pt-6 pb-4': placement === 'mobile' },
    { 'w-full md:w-auto': placement === 'footer' },
  ]}
>
  <ul class:list={[
    'list-none m-0 p-0',
    { 'flex items-center gap-8': placement === 'desktop' },
    { 'flex flex-col gap-4': placement === 'mobile' },
    { 'flex flex-wrap gap-x-6 gap-y-3 text-sm': placement === 'footer' },
  ]}>
    {items.map((item) => {
      const active = isNavigationItemActive(item, currentPath);
      return (
        <li>
          <a
            href={item.href}
            aria-current={active ? 'page' : undefined}
            class:list={[
              'nav-link',
              { 'block py-1': placement === 'mobile' },
              { 'text-ink-muted hover:text-sage-600': placement === 'footer' },
            ]}
          >
            {item.label}
          </a>
        </li>
      );
    })}
  </ul>
</nav>
