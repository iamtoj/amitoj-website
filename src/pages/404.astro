---
import Layout from '../layouts/Layout.astro';
---

<Layout
  title="Page not found | Amitoj Singh"
  description="The page you were looking for could not be found."
  canonicalPath="/404"
  noindex
>
  <section class="container-zen section-zen">
    <div class="max-w-2xl">
      <p class="text-ink-muted text-sm mb-4">404</p>
      <h1 class="mb-8 text-balance">Page not found</h1>
      <div class="accent-line mb-8"></div>
      <p class="text-ink-light mb-8">
        The page may have moved, or the address may be incomplete.
      </p>
      <a href="/" class="arrow-link">Return home</a>
    </div>
  </section>
</Layout>
