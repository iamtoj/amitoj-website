---
import Layout from '../layouts/Layout.astro';

// Featured essays to show on homepage (must match essays.astro)
const featuredEssays = [
  {
    slug: 'the-right-direction',
    title: 'The Right Direction',
    description: 'Markets coordinate within rules they cannot choose. Better measurement sharpens the question of which objectives matter, without settling it.',
  },
  {
    slug: 'strategic-time',
    title: 'Strategic Time',
    description: 'Strategy needs time to pursue a commitment and learn whether it works. Organizations must protect that time from both rapid market signals and pressure to survive at any cost.',
  },
  {
    slug: 'architecture-of-commitment',
    title: 'The Architecture of Commitment',
    description: 'Organizations need stable purposes and methods that adapt to evidence. The question is which commitments to protect, which to revise, and what should trigger each change.',
  },
];
---

<Layout title="Amitoj Singh">
  <!-- Hero Photo -->
  <section class="container-zen pt-12 pb-8">
    <div class="max-w-3xl">
      <img
        src="/images/photography-optimized/DSCF0573.webp"
        alt="Two red Adirondack chairs in an autumn garden"
        class="w-full h-72 object-cover"
        style="object-position: center 80%;"
      />
    </div>
  </section>

  <section class="container-zen section-zen pt-8">
    <div class="max-w-2xl">
      <h1 class="mb-8 text-balance">
        Amitoj Singh
      </h1>

      <div class="accent-line mb-8"></div>

      <p class="text-ink-light mb-4">
        I’ve worked as an entrepreneur and institutional investor across private equity, venture capital, and hedge fund investing. Now I’m a PhD student at Harvard Business School, researching how organizations allocate attention and find direction. I’m based in Boston, teach yoga at HBS, and write about what changes when machines can take on cognitive work.
      </p>

      <nav class="flex gap-6">
        <a href="/third-enlightenment" class="arrow-link">The Third Enlightenment</a>
        <a href="/writing" class="arrow-link">Read my writing</a>
        <a href="/about" class="arrow-link">About me</a>
      </nav>
    </div>
  </section>

  <section class="container-zen section-zen border-t border-oat-300">
    <h2 class="text-2xl mb-8 section-header">What I Practice</h2>

    <p class="text-ink-light mb-10 max-w-prose">
      Two questions organize everything I do: <em>awareness</em> — what is actually happening? — and <em>agency</em> — what should we do, and what can we do? Both questions apply inward and outward.
    </p>

    <div class="matrix-wrap">
      <div class="practice-matrix">
        <div class="matrix-corner"></div>
        <div class="matrix-col-label">Internal</div>
        <div class="matrix-col-label">External</div>

        <div class="matrix-row-label">Awareness</div>
        <a class="matrix-cell" href="/yoga" data-label="Awareness · Internal">
          <span class="matrix-cell-title">Yoga</span>
          <span class="matrix-cell-desc">What matters to you</span>
          <span class="matrix-cell-arrow">→</span>
        </a>
        <a class="matrix-cell" href="/writing" data-label="Awareness · External">
          <span class="matrix-cell-title">Research & Investing</span>
          <span class="matrix-cell-desc">What matters to others</span>
          <span class="matrix-cell-arrow">→</span>
        </a>

        <div class="matrix-row-label">Agency</div>
        <a class="matrix-cell" href="/about" data-label="Agency · Internal">
          <span class="matrix-cell-title">Executive Coaching</span>
          <span class="matrix-cell-desc">Clarity into action</span>
          <span class="matrix-cell-arrow">→</span>
        </a>
        <a class="matrix-cell" href="/work" data-label="Agency · External">
          <span class="matrix-cell-title">Consulting</span>
          <span class="matrix-cell-desc">Putting organizations into motion</span>
          <span class="matrix-cell-arrow">→</span>
        </a>
      </div>
    </div>
  </section>

  <section class="container-zen section-zen border-t border-oat-300">
    <h2 class="text-2xl mb-8 section-header">Third Enlightenment</h2>

    <div class="max-w-2xl feature-box">
      <p class="text-ink-light mb-6">
        Writing and print let us externalize memory. Digital systems let us externalize computation. Now artificial intelligence lets us externalize cognition itself.
      </p>

      <a href="/third-enlightenment" class="arrow-link">Read the framework</a>
    </div>
  </section>

  <section class="container-zen section-zen border-t border-oat-300">
    <h2 class="text-2xl mb-8 section-header">Featured Essays</h2>

    <ul class="list-none m-0 p-0">
      {featuredEssays.map((essay, index) => (
        <li class:list={["essay-hover", { "border-b border-oat-300": index < featuredEssays.length - 1 }]}>
          <a href={`/essays/${essay.slug}`} class="no-underline block">
            <h3 class="text-xl mb-2 transition-colors">
              {essay.title}
            </h3>
            <p class="text-ink-light">
              {essay.description}
            </p>
          </a>
        </li>
      ))}
    </ul>

    <div class="mt-8">
      <a href="/writing" class="arrow-link">View all writing</a>
    </div>
  </section>
</Layout>

<style>
  .matrix-wrap {
    max-width: 680px;
  }

  .practice-matrix {
    display: grid;
    grid-template-columns: 32px 1fr 1fr;
    grid-template-rows: 32px 1fr 1fr;
  }

  @media (min-width: 768px) {
    .practice-matrix {
      grid-template-columns: 40px 1fr 1fr;
      grid-template-rows: 36px 1fr 1fr;
    }
  }

  .matrix-corner { }

  .matrix-col-label {
    display: flex;
    align-items: flex-end;
    justify-content: center;
    padding-bottom: 12px;
    font-family: system-ui, -apple-system, sans-serif;
    font-size: 10px;
    letter-spacing: 0.16em;
    text-transform: uppercase;
    color: #8A857E;
    font-weight: 500;
  }

  @media (min-width: 768px) {
    .matrix-col-label { font-size: 11px; }
  }

  .matrix-row-label {
    display: flex;
    align-items: center;
    justify-content: center;
    writing-mode: vertical-lr;
    transform: rotate(180deg);
    font-family: system-ui, -apple-system, sans-serif;
    font-size: 10px;
    letter-spacing: 0.16em;
    text-transform: uppercase;
    color: #8A857E;
    font-weight: 500;
    padding-right: 12px;
  }

  @media (min-width: 768px) {
    .matrix-row-label { font-size: 11px; padding-right: 14px; }
  }

  .matrix-cell {
    display: flex;
    flex-direction: column;
    align-items: center;
    justify-content: center;
    text-align: center;
    padding: 28px 16px;
    background: #FAF8F4;
    border: 1px solid #EBE3D4;
    text-decoration: none;
    color: inherit;
    transition: background 0.25s ease, border-color 0.25s ease;
  }

  @media (min-width: 768px) {
    .matrix-cell { padding: 36px 28px; }
  }

  /* Collapse double borders between cells */
  /* nth-of-type counts <a> tags only: 1=top-left, 2=top-right, 3=bottom-left, 4=bottom-right */
  .matrix-cell:nth-of-type(1) { border-right: none; }
  .matrix-cell:nth-of-type(3) { border-right: none; border-top: none; }
  .matrix-cell:nth-of-type(4) { border-top: none; }

  .matrix-cell:hover {
    background: #f4f6f2;
    border-color: #B2BDA0;
  }

  .matrix-cell-title {
    font-family: 'EB Garamond', Georgia, serif;
    font-size: 19px;
    font-weight: 500;
    letter-spacing: -0.01em;
    margin-bottom: 6px;
    transition: color 0.2s ease;
  }

  @media (min-width: 768px) {
    .matrix-cell-title { font-size: 21px; }
  }

  .matrix-cell:hover .matrix-cell-title {
    color: #6B7D56;
  }

  .matrix-cell-desc {
    font-size: 15px;
    color: #5A5651;
    font-style: italic;
    line-height: 1.5;
    margin-bottom: 12px;
    max-width: 22ch;
  }

  .matrix-cell-arrow {
    font-size: 14px;
    color: #82966A;
    opacity: 0;
    transition: opacity 0.2s ease;
  }

  .matrix-cell:hover .matrix-cell-arrow {
    opacity: 1;
  }

  /* Mobile: stack to single column */
  @media (max-width: 540px) {
    .practice-matrix {
      grid-template-columns: 1fr;
      grid-template-rows: auto;
    }

    .matrix-corner,
    .matrix-col-label,
    .matrix-row-label {
      display: none;
    }

    .matrix-cell {
      border: 1px solid #EBE3D4 !important;
      margin-bottom: -1px;
      padding: 24px 20px;
    }

    .matrix-cell::before {
      content: attr(data-label);
      display: block;
      font-family: system-ui, -apple-system, sans-serif;
      font-size: 10px;
      letter-spacing: 0.14em;
      text-transform: uppercase;
      color: #8A857E;
      margin-bottom: 8px;
      font-style: normal;
    }

    .matrix-cell-arrow {
      opacity: 1;
    }
  }
</style>
