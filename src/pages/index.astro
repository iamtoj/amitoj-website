---
import Layout from '../layouts/Layout.astro';

// Featured essays to show on homepage (must match essays.astro)
const featuredEssays = [
  {
    slug: 'the-right-direction',
    title: 'The Right Direction',
    description: 'Markets coordinate brilliantly within frameworks they cannot generate. Price signals tell you how to win the game  -  they can\'t tell you whether it\'s the right game.',
  },
  {
    slug: 'strategic-time',
    title: 'Strategic Time',
    description: 'Strategic choice lives in a narrow temporal zone between market degeneration and survival pressure. The mismatch between three clocks is where strategy happens.',
  },
  {
    slug: 'architecture-of-commitment',
    title: 'The Architecture of Commitment',
    description: 'As measurement improves, execution becomes tractable. What remains contested is what the organization should be pursuing in the first place.',
  },
];
---

<Layout title="Amitoj Singh">
  <!-- Hero Photo -->
  <section class="container-zen pt-12 pb-8">
    <div class="max-w-3xl">
      <img
        src="/images/photography-optimized/DSCF0573.webp"
        alt="Two red Adirondack chairs in an autumn garden"
        class="w-full h-72 object-cover"
        style="object-position: center 80%;"
      />
    </div>
  </section>

  <section class="container-zen section-zen pt-8">
    <div class="max-w-2xl">
      <h1 class="mb-8 text-balance">
        Amitoj Singh
      </h1>

      <div class="accent-line mb-8"></div>

      <p class="text-ink-light mb-4">
        I built an institutional investment fund and still serve as senior advisor. Now a PhD student at Harvard Business School, researching how organizations allocate attention and find direction. Based in Boston, teaching yoga at HBS, writing about what happens when cognition itself becomes something we can externalize.
      </p>

      <nav class="flex gap-6">
        <a href="/third-enlightenment" class="arrow-link">The Third Enlightenment</a>
        <a href="/writing" class="arrow-link">Read my writing</a>
        <a href="/about" class="arrow-link">About me</a>
      </nav>
    </div>
  </section>

  <section class="container-zen section-zen border-t border-oat-300">
    <h2 class="text-2xl mb-8 section-header">Third Enlightenment</h2>

    <div class="max-w-2xl feature-box">
      <p class="text-ink-light mb-6">
        Writing and print let us externalize memory. Digital systems let us externalize computation. Now artificial intelligence lets us externalize cognition itself.
      </p>

      <a href="/third-enlightenment" class="arrow-link">Read the framework</a>
    </div>
  </section>

  <section class="container-zen section-zen border-t border-oat-300">
    <h2 class="text-2xl mb-8 section-header">Featured Essays</h2>

    <ul class="list-none m-0 p-0">
      {featuredEssays.map((essay, index) => (
        <li class:list={["essay-hover", { "border-b border-oat-300": index < featuredEssays.length - 1 }]}>
          <a href={`/essays/${essay.slug}`} class="no-underline block">
            <h3 class="text-xl mb-2 transition-colors">
              {essay.title}
            </h3>
            <p class="text-ink-light">
              {essay.description}
            </p>
          </a>
        </li>
      ))}
    </ul>

    <div class="mt-8">
      <a href="/writing" class="arrow-link">View all writing</a>
    </div>
  </section>
</Layout>
