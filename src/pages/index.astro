---
import Layout from '../layouts/Layout.astro';
import { practiceClaims, siteFacts, theoryClaims } from '../data/site-facts';
import { getPublishedEssays } from '../lib/content';

const featuredEssays = (await getPublishedEssays())
  .filter((essay) => essay.data.homeFeature)
  .sort((left, right) => left.data.homeFeature!.sortOrder - right.data.homeFeature!.sortOrder);
---

<Layout
  title="Amitoj Singh | Research, writing, and practices of attention"
  description={`Amitoj Singh researches ${siteFacts.researchFocus}.`}
>
  <section class="home-hero container-zen" data-home-hero>
    <div class="home-hero-grid" data-home-hero-grid>
      <div class="home-hero-copy" data-home-hero-copy>
        <h1 class="mb-4 text-balance">Amitoj Singh</h1>
        <div class="accent-line mb-5"></div>

        <p class="text-lg text-ink-light mb-4">
          I study {siteFacts.researchFocus}.
        </p>

        <p class="text-ink-muted mb-5">
          The question grew out of {siteFacts.professionalHistory}. I now follow it through organizational research, writing, yoga, coaching, and photography.
        </p>

        <nav aria-label="Begin with" class="flex flex-wrap gap-x-6 gap-y-2">
          <a href="/research" class="arrow-link">Research</a>
          <a href="/writing" class="arrow-link">Writing</a>
        </nav>
      </div>

      <img
        src="/images/profile.jpeg"
        alt="Amitoj Singh smiling while seated beside the water, with a city skyline behind him"
        class="home-portrait"
        width="768"
        height="1024"
      />
    </div>
  </section>

  <section class="container-zen section-zen border-t border-oat-300" data-public-questions>
    <div class="max-w-3xl">
      <h2 class="text-2xl mb-4 section-header">Questions in public</h2>

      <div class="border-y border-oat-300">
        <a href="/research" class="question-row no-underline">
          <span class="text-sm text-ink-muted">Research</span>
          <span class="text-lg">How does an organization decide what deserves attention before it can measure what worked?</span>
        </a>
        <a href="/research#organizational-work" class="question-row no-underline border-t border-oat-300">
          <span class="text-sm text-ink-muted">Organizational work</span>
          <span class="text-lg">When a system proposes the next move, who may revise the objective?</span>
        </a>
      </div>
    </div>
  </section>

  <section class="container-zen section-zen border-t border-oat-300" data-practice-map>
    <div class="max-w-3xl">
      <h2 class="text-2xl mb-4 section-header">Practices</h2>
      <p class="text-ink-light mb-8">I do not experience these as separate interests. Each places attention under a different kind of pressure.</p>

      <div class="practice-map-grid" role="group" aria-label="Investing, yoga, coaching, and photography">
        <a href={practiceClaims.router.investing.href} class="practice-path no-underline" data-practice-path>
          <span class="text-sm text-ink-muted">{practiceClaims.router.investing.label}</span>
          <h3 class="text-xl">{practiceClaims.router.investing.title}</h3>
          <p class="text-ink-light">{practiceClaims.router.investing.summary}</p>
        </a>
        <a href={practiceClaims.router.yoga.href} class="practice-path no-underline" data-practice-path>
          <span class="text-sm text-ink-muted">{practiceClaims.router.yoga.label}</span>
          <h3 class="text-xl">{practiceClaims.router.yoga.title}</h3>
          <p class="text-ink-light">{practiceClaims.router.yoga.summary}</p>
        </a>
        <a href={practiceClaims.router.coaching.href} class="practice-path no-underline" data-practice-path>
          <span class="text-sm text-ink-muted">{practiceClaims.router.coaching.label}</span>
          <h3 class="text-xl">{practiceClaims.router.coaching.title}</h3>
          <p class="text-ink-light">{practiceClaims.router.coaching.summary}</p>
        </a>
        <a href={practiceClaims.router.photography.href} class="practice-path no-underline" data-practice-path>
          <span class="text-sm text-ink-muted">{practiceClaims.router.photography.label}</span>
          <h3 class="text-xl">{practiceClaims.router.photography.title}</h3>
          <p class="text-ink-light">{practiceClaims.router.photography.summary}</p>
        </a>
      </div>
    </div>
  </section>

  <section class="container-zen section-zen border-t border-oat-300" data-working-theory>
    <div class="max-w-2xl feature-box">
      <p class="text-sm text-ink-muted uppercase tracking-wider mb-3">Working theory</p>
      <h2 class="text-2xl mb-4">Third Enlightenment</h2>
      <p class="text-ink-light mb-6">
        {theoryClaims.homeEvidence}
      </p>
      <a href="/third-enlightenment" class="arrow-link">Read the working theory</a>
    </div>
  </section>

  <section class="container-zen section-zen border-t border-oat-300" data-recent-essays>
    <div class="max-w-3xl">
      <h2 class="text-2xl mb-8 section-header">Recent Essays</h2>

      <div class="divide-y divide-oat-300">
        {featuredEssays.map((essay) => (
          <article class="py-6 first:pt-0 last:pb-0">
            <a href={`/essays/${essay.data.slug}`} class="group block no-underline">
              <h3 class="text-xl mb-2 group-hover:text-sage-600 transition-colors">{essay.data.title}</h3>
              <p class="text-ink-light">{essay.data.homeFeature!.summary}</p>
            </a>
          </article>
        ))}
      </div>

      <div class="mt-8">
        <a href="/writing" class="arrow-link">All writing</a>
      </div>
    </div>
  </section>
</Layout>

<style>
  .home-hero {
    padding-top: 1.5rem;
    padding-bottom: 2.5rem;
  }

  .home-hero-grid {
    display: grid;
    grid-template-columns: minmax(0, 1fr);
    gap: 1.25rem;
    align-items: center;
    max-width: 56rem;
  }

  .home-hero-copy {
    max-width: 39rem;
  }

  .home-portrait {
    display: block;
    width: 100%;
    height: 8.5rem;
    object-fit: cover;
    object-position: center 16%;
  }

  .question-row {
    display: grid;
    grid-template-columns: minmax(8rem, 0.35fr) minmax(0, 1fr);
    gap: 1.5rem;
    padding: 1.5rem 0;
    align-items: baseline;
  }

  .question-row:hover span:last-child {
    color: #6B7D56;
  }

  .practice-map-grid {
    display: grid;
    grid-template-columns: minmax(0, 1fr);
    border-top: 1px solid #DED6C8;
  }

  .practice-path {
    display: grid;
    gap: 0.35rem;
    padding: 1.5rem 0;
    border-bottom: 1px solid #DED6C8;
  }

  .practice-path:hover h3 {
    color: #6B7D56;
  }

  @media (min-width: 768px) {
    .home-hero {
      padding-top: 2rem;
      padding-bottom: 4rem;
    }

    .home-hero-grid {
      grid-template-columns: minmax(0, 1.45fr) minmax(15rem, 0.75fr);
      gap: 4rem;
    }

    .home-portrait {
      height: 25rem;
      object-position: center top;
    }

    .practice-map-grid {
      grid-template-columns: repeat(2, minmax(0, 1fr));
    }

    .practice-path:nth-child(odd) {
      padding-right: 2rem;
      border-right: 1px solid #DED6C8;
    }

    .practice-path:nth-child(even) {
      padding-left: 2rem;
    }
  }

  @media (max-width: 540px) {
    .home-hero {
      padding-top: 1rem;
      padding-bottom: 1.5rem;
    }

    .home-hero-grid {
      gap: 0.75rem;
    }

    .home-hero-copy h1 {
      font-size: 2.25rem;
      line-height: 1.1;
      margin-bottom: 0.75rem;
    }

    .home-hero-copy > p:first-of-type {
      font-size: 1.125rem;
      line-height: 1.5;
      margin-bottom: 0.75rem;
    }

    .home-hero-copy > p:nth-of-type(2) {
      font-size: 1rem;
      line-height: 1.5;
      margin-bottom: 1rem;
    }

    .question-row {
      grid-template-columns: minmax(0, 1fr);
      gap: 0.35rem;
    }
  }
</style>
