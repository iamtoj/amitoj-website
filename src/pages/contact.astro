---
import ContactForm from '../components/ContactForm.astro';
import Layout from '../layouts/Layout.astro';
---

<Layout
  title="Contact | Amitoj Singh"
  description="Send Amitoj Singh a response, question, or connection prompted by the work on this site."
>
  <section class="container-zen pt-8 md:pt-12 pb-8">
    <div class="max-w-3xl">
      <img
        src="/images/photography-optimized/IMG_2306.webp"
        alt="Golden sunset clouds against a deep blue sky"
        class="contact-hero"
        width="1600"
        height="1200"
        loading="eager"
        fetchpriority="high"
        decoding="async"
      />
    </div>
  </section>

  <section class="container-zen section-zen pt-8">
    <div class="max-w-2xl">
      <h1 class="mb-6 text-balance">Contact</h1>
      <div class="accent-line mb-8"></div>
      <p class="text-lg text-ink-light">If something here gave you a question, a disagreement, or a connection, you can send it here.</p>
    </div>
  </section>

  <section class="container-zen section-zen border-t border-oat-300 bg-oat-100">
    <div class="max-w-2xl">
      <h2 class="text-2xl mb-8 section-header">Send a message</h2>
      <ContactForm />
    </div>
  </section>
</Layout>

<style>
  .contact-hero {
    display: block;
    width: 100%;
    max-height: 28rem;
    object-fit: cover;
    object-position: center 42%;
  }
</style>
