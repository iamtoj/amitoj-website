---
import Layout from '../layouts/Layout.astro';
import { photographs } from '../data/photography';
---

<Layout title="Photography | Amitoj Singh" description="A contact sheet: seeing as a form of attention.">
  <section class="container-zen section-zen">
    <div class="max-w-2xl">
      <h1 class="mb-6 text-balance">Photography</h1>
      <div class="accent-line mb-8"></div>
      <p class="text-lg text-ink-light">Seeing as a form of attention.</p>
    </div>
  </section>

  <section class="container-zen section-zen border-t border-oat-300" data-contact-sheet>
    <div class="contact-sheet">
      {photographs.map((photo, index) => (
        <figure class="contact-sheet-item">
          <img
            src={`/images/photography-optimized/${photo.filename}`}
            alt={photo.alt}
            width={photo.width}
            height={photo.height}
            loading={index === 0 ? 'eager' : 'lazy'}
            fetchpriority={index === 0 ? 'high' : 'auto'}
            decoding="async"
          />
        </figure>
      ))}
    </div>
  </section>

  <section class="container-zen section-zen border-t border-oat-300">
    <a href="/practices" class="arrow-link">All practices</a>
  </section>
</Layout>

<style>
  .contact-sheet {
    column-count: 1;
    column-gap: 1.5rem;
  }

  .contact-sheet-item {
    margin: 0 0 1rem;
    break-inside: avoid;
  }

  .contact-sheet-item img {
    display: block;
    width: 100%;
    height: auto;
    transition: opacity 0.3s ease, transform 0.3s ease;
  }

  .contact-sheet-item:hover img {
    opacity: 0.95;
    transform: scale(1.01);
  }

  @media (min-width: 768px) {
    .contact-sheet {
      column-count: 2;
    }
  }
</style>
