---
import Layout from '../../layouts/Layout.astro';
import EditorialLabel from '../../components/EditorialLabel.astro';
import { getEditorialNetwork, getPublishedReadingAnnotations } from '../../lib/content';

const network = await getEditorialNetwork();
const books = await getPublishedReadingAnnotations();
const bookCards = books.map((entry) => ({
  entry,
  target: network.resolve({ kind: 'annotation', slug: entry.data.slug }),
}));
const allTags = ['All', ...new Set(books.flatMap((book) => book.data.cardTags!))];
---

<Layout title="Library | Amitoj Singh" description="Books that earned their place through re-reading, annotation, and integration into how I work.">
  <!-- Hero Photo -->
  <section class="container-zen pt-12 pb-8">
    <div class="max-w-3xl">
      <img
        src="/images/library-optimized.jpg"
        alt="Books on a shelf"
        class="w-full h-72 object-cover"
        style="object-position: center 50%;"
      />
    </div>
  </section>

  <section class="container-zen section-zen pt-8">
    <div class="max-w-3xl">
      <h1 class="mb-8 text-balance">Library</h1>

      <div class="accent-line mb-8"></div>

      <p class="text-lg text-ink-light mb-12">
        Books that earned their place through re-reading and annotation.
      </p>

      <!-- Filter chips -->
      <div class="flex flex-wrap gap-2 mb-4" id="filter-container" aria-label="Filter reading annotations">
        {allTags.map((tag, index) => (
          <button
            type="button"
            class={`px-4 py-2 text-sm rounded-full transition-colors filter-chip ${index === 0 ? 'bg-ink text-oat-50' : 'bg-oat-200 text-ink hover:bg-oat-300'}`}
            data-tag={tag}
            aria-pressed={index === 0 ? 'true' : 'false'}
            aria-controls="book-list"
          >
            {tag}
          </button>
        ))}
      </div>
      <p class="text-sm text-ink-muted mb-12" id="filter-status" role="status" aria-live="polite" aria-atomic="true">
        {books.length} reading annotations
      </p>

      <!-- Book cards -->
      <div class="space-y-8" id="book-list">
        {bookCards.map(({ entry: book, target }) => (
          <article class="group border-b border-oat-300 pb-8" data-tags={book.data.cardTags!.join(',')} data-library-slug={book.data.slug}>
            <a href={target.path} class="block no-underline">
              <div class="flex justify-between items-start gap-4">
                <div>
                  <EditorialLabel form={target.form} />
                  <h2 class="text-xl mb-1 group-hover:text-sage-600 transition-colors">
                    {book.data.cardTitle}
                  </h2>
                  <p class="text-ink-muted mb-3">{book.data.cardAuthor}</p>
                  <p class="text-ink-light mb-4">{book.data.teaser}</p>
                  <div class="flex flex-wrap gap-2 text-sm text-ink-muted">
                    <span>{book.data.cardReadingTime}</span>
                    <span class="text-oat-400">·</span>
                    <span>{book.data.cardDifficulty}</span>
                    <span class="text-oat-400">·</span>
                    {book.data.cardTags!.map((tag, i) => (
                      <span>
                        {tag}{i < book.data.cardTags!.length - 1 ? ', ' : ''}
                      </span>
                    ))}
                  </div>
                </div>
                <span class="text-ink-muted group-hover:text-sage-600 transition-colors text-xl">→</span>
              </div>
            </a>
          </article>
        ))}
      </div>
    </div>
  </section>
</Layout>

<script>
  const chips = Array.from(document.querySelectorAll<HTMLButtonElement>('.filter-chip'));
  const books = Array.from(document.querySelectorAll<HTMLElement>('#book-list article'));
  const status = document.querySelector<HTMLElement>('#filter-status');

  chips.forEach(chip => {
    chip.addEventListener('click', () => {
      const tag = chip.dataset.tag ?? 'All';

      chips.forEach(c => {
        c.classList.remove('bg-ink', 'text-oat-50');
        c.classList.add('bg-oat-200', 'text-ink', 'hover:bg-oat-300');
        c.setAttribute('aria-pressed', 'false');
      });
      chip.classList.remove('bg-oat-200', 'text-ink', 'hover:bg-oat-300');
      chip.classList.add('bg-ink', 'text-oat-50');
      chip.setAttribute('aria-pressed', 'true');

      let visibleCount = 0;
      books.forEach(book => {
        const bookTags = (book.dataset.tags ?? '').split(',').filter(Boolean);
        const matches = tag === 'All' || bookTags.includes(tag);
        book.hidden = !matches;
        if (matches) visibleCount += 1;
      });
      if (status) status.textContent = `${visibleCount} reading ${visibleCount === 1 ? 'annotation' : 'annotations'}`;
    });
  });
</script>
