---
import Analytics from '@vercel/analytics/astro';
import BaseHead, { type Props as BaseHeadProps } from '../components/BaseHead.astro';
import SiteNavigation from '../components/SiteNavigation.astro';

interface Props extends BaseHeadProps {}

const head = Astro.props;
---

<!doctype html>
<html lang="en">
  <head>
    <BaseHead {...head} />
  </head>
  <body>
    <a href="#main-content" class="skip-link sr-only focus:not-sr-only">
      Skip to content
    </a>

    <header class="container-zen py-8 md:py-12">
      <div class="flex items-center justify-between gap-6">
        <a href="/" class="text-xl no-underline hover:text-ink-light">
          Amitoj Singh
        </a>

        <SiteNavigation placement="desktop" currentPath={Astro.url.pathname} />

        <button
          id="mobile-menu-button"
          class="md:hidden p-2 -mr-2"
          type="button"
          aria-label="Open site navigation"
          aria-expanded="false"
          aria-controls="mobile-site-navigation"
        >
          <svg class="w-6 h-6" fill="none" stroke="currentColor" viewBox="0 0 24 24" aria-hidden="true" focusable="false">
            <path data-menu-icon stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M4 6h16M4 12h16M4 18h16"></path>
            <path data-close-icon class="hidden" stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M6 18L18 6M6 6l12 12"></path>
          </svg>
        </button>
      </div>

      <SiteNavigation
        id="mobile-site-navigation"
        placement="mobile"
        currentPath={Astro.url.pathname}
        hidden
      />
    </header>

    <main id="main-content" tabindex="-1">
      <slot />
    </main>

    <footer class="container-zen py-16 border-t border-sage-200 mt-22" style="background: linear-gradient(180deg, #F5F0E6 0%, #F4F6F2 100%);">
      <div class="flex flex-col md:flex-row justify-between items-start md:items-center gap-6">
        <p class="text-ink-muted text-sm m-0 flex-shrink-0">
          &copy; {new Date().getFullYear()} Amitoj Singh
        </p>
        <SiteNavigation placement="footer" currentPath={Astro.url.pathname} />
      </div>
    </footer>

    <script>
      const button = document.querySelector<HTMLButtonElement>('#mobile-menu-button');
      const panel = document.querySelector<HTMLElement>('#mobile-site-navigation');
      const menuIcon = document.querySelector<SVGPathElement>('[data-menu-icon]');
      const closeIcon = document.querySelector<SVGPathElement>('[data-close-icon]');
      const skipLink = document.querySelector<HTMLAnchorElement>('.skip-link');
      const main = document.querySelector<HTMLElement>('#main-content');
      const desktopNavigation = document.querySelector<HTMLElement>('nav[aria-label="Primary navigation"]');
      let lastFocusedMobileHref: string | null = null;
      let lastFocusRegion: 'trigger' | 'mobile' | 'desktop' | 'other' = 'other';

      const setNavigationOpen = (
        open: boolean,
        { restoreFocus = false, focusTarget = null }: { restoreFocus?: boolean; focusTarget?: HTMLElement | null } = {},
      ) => {
        if (!button || !panel) return;
        const focusedInsidePanel = document.activeElement instanceof HTMLElement
          && panel.contains(document.activeElement);
        button.setAttribute('aria-expanded', String(open));
        button.setAttribute('aria-label', open ? 'Close site navigation' : 'Open site navigation');
        panel.hidden = !open;
        menuIcon?.classList.toggle('hidden', open);
        closeIcon?.classList.toggle('hidden', !open);
        const nextFocus = focusTarget ?? (restoreFocus || focusedInsidePanel ? button : null);
        if (!open && nextFocus) requestAnimationFrame(() => nextFocus.focus());
      };

      setNavigationOpen(false);
      button?.addEventListener('click', () => {
        setNavigationOpen(button.getAttribute('aria-expanded') !== 'true');
      });
      document.addEventListener('focusin', (event) => {
        const target = event.target;
        if (!(target instanceof Element)) return;
        if (target === button) {
          lastFocusRegion = 'trigger';
        } else if (panel?.contains(target)) {
          lastFocusRegion = 'mobile';
          const link = target.closest<HTMLAnchorElement>('a[href]');
          if (link) lastFocusedMobileHref = link.getAttribute('href');
        } else if (desktopNavigation?.contains(target)) {
          lastFocusRegion = 'desktop';
        } else {
          lastFocusRegion = 'other';
        }
      });
      panel?.addEventListener('click', (event) => {
        const link = (event.target as Element).closest('a[href]');
        if (
          link
          && event instanceof MouseEvent
          && event.button === 0
          && !event.defaultPrevented
          && !event.altKey
          && !event.ctrlKey
          && !event.metaKey
          && !event.shiftKey
        ) {
          setNavigationOpen(false);
        }
      });
      document.addEventListener('keydown', (event) => {
        if (event.key === 'Escape' && button?.getAttribute('aria-expanded') === 'true') {
          setNavigationOpen(false, { restoreFocus: true });
        }
      });

      const breakpoint = window.matchMedia('(min-width: 768px)');
      breakpoint.addEventListener('change', (event) => {
        const active = document.activeElement;
        const wasOpen = button?.getAttribute('aria-expanded') === 'true';
        let focusTarget: HTMLElement | null = null;

        if (event.matches && desktopNavigation) {
          if (active === button || lastFocusRegion === 'trigger') {
            focusTarget = desktopNavigation.querySelector<HTMLElement>('[aria-current="page"]')
              ?? desktopNavigation.querySelector<HTMLElement>('a[href]');
          } else {
            const mobileHref = active instanceof HTMLAnchorElement && panel?.contains(active)
              ? active.getAttribute('href')
              : wasOpen && lastFocusRegion === 'mobile'
                ? lastFocusedMobileHref
                : null;
            if (mobileHref) {
              focusTarget = [...desktopNavigation.querySelectorAll<HTMLAnchorElement>('a[href]')]
                .find((link) => link.getAttribute('href') === mobileHref) ?? null;
            }
          }
        } else if (
          !event.matches
          && ((active instanceof HTMLElement && desktopNavigation?.contains(active)) || lastFocusRegion === 'desktop')
        ) {
          focusTarget = button;
        }

        setNavigationOpen(false, { focusTarget });
      });
      window.addEventListener('pageshow', () => setNavigationOpen(false));
      window.addEventListener('popstate', () => setNavigationOpen(false));

      skipLink?.addEventListener('click', () => {
        requestAnimationFrame(() => main?.focus());
      });
    </script>
    <Analytics />
  </body>
</html>

<style is:global>
  @import '../styles/global.css';
</style>
